# development mein development, live server par production
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/veloura_store

# Frontend ka address. Kai ho to comma se alag karein:
# https://yourstore.com,https://www.yourstore.com
CLIENT_URL=http://localhost:5173

# Admin panel login (/admin/login). Zaroor badal dein.
# production mein default password se login band rehta hai.
ADMIN_EMAIL=admin@veloura.com
ADMIN_PASSWORD=admin12345

# Koi bhi lamba random text. production mein zaroori hai.
JWT_SECRET=change-this-to-a-long-random-text

# ---------- Optional: live hone ke baad ----------

# Backend ka apna public address (free hosting par server ko jagaye rakhne ke liye)
SELF_URL=

# Naye order ki email (Resend API key). NOTIFY_EMAIL mein apni email.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Naye order ka Telegram message
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
